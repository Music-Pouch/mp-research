# FREE GAME baseline: Ollama + Qwen + DuckDuckGo
RETRIEVER=duckduckgo
OPENAI_API_KEY=ollama
OPENAI_API_BASE=http://127.0.0.1:11434/v1
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
FAST_LLM=ollama:qwen3:4b
SMART_LLM=ollama:qwen3:4b
STRATEGIC_LLM=ollama:qwen3:4b
EMBEDDING=ollama:nomic-embed-text

# Optional overrides for paid providers:
# Replace OPENAI_API_KEY=ollama with a real provider key, then set
# provider-specific model and retriever values as needed.
# TAVILY_API_KEY=
# GITHUB_TOKEN=
